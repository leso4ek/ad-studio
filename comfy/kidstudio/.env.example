# Kid Studio settings. Copy to .env (scripts/install_linux.sh does it) and fill in your key there.
# Never paste the key into a chat; type it only into this file on your own computer.
OPENROUTER_API_KEY=

# Hard spending cap in USD across all OpenRouter calls logged in runs/ledger.jsonl.
KIDSTUDIO_BUDGET_USD=25

# 1 = free test mode: no API calls, placeholder images and clips.
KIDSTUDIO_MOCK=0

# Where the Kokoro voice model lives (download_models.sh puts it here by default).
# KIDSTUDIO_KOKORO_DIR=/path/to/kidstudio/models/kokoro
