# MiroFish .env for Ad Studio audience tests (local graph, no Zep account)
# Cloud session: the proxy injects the OpenRouter key, so the placeholder stays.
# Your PC: replace LLM_API_KEY with your own OpenRouter key (never commit it).
LLM_API_KEY=proxy-injected
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL_NAME=deepseek/deepseek-v4.1-flash-1017
# local graph instead of Zep Cloud; "local" is a placeholder, not a key
MIROFISH_LOCAL_GRAPH=1
ZEP_API_KEY=local
# token economy
OASIS_DEFAULT_MAX_ROUNDS=24
REPORT_AGENT_MAX_TOOL_CALLS=3
REPORT_AGENT_MAX_REFLECTION_ROUNDS=1
LOCAL_GRAPH_WORKERS=4
