# Ad Studio secrets: copy to studio/.env (chmod 600) and fill in only what you use. Never paste keys into a chat.
# ElevenLabs (free tier, premade voices; also set "elevenlabs.enabled": true in config.local.json)
ELEVENLABS_API_KEY=
# VoiceStudio, only if your backend has auth turned on
VOICESTUDIO_API_KEY=
