  {
   "t0": 0.0,
   "t1": 2.12,
   "text": "If you water a fern, where does it all go?"
  },
  {
   "t0": 3.54,
   "t1": 5.2,
   "text": "The topsoil soaks it up first,"
  },
  {
   "t0": 6.26,
   "t1": 8.14,
   "text": "but only the roots can drink it."
  },
  {
   "t0": 9.18,
   "t1": 11.24,
   "text": "So the extra sinks through the gravel"
  },
  {
   "t0": 12.0,
   "t1": 13.72,
   "text": "and drains into the saucer."
  },
  {
   "t0": 15.32,
   "t1": 17.22,
   "text": "Sprigly, one cap full per liter."
  }
 ],
