[
  {
    "t0": 0.3,
    "t1": 3.16,
    "text": "Every Sunday, Juno and her fern have a standoff.",
    "speaker": "narrator",
    "line": "l01"
  },
  {
    "t0": 3.4,
    "t1": 5.24,
    "text": "She waters, she guesses, she hopes.",
    "speaker": "narrator",
    "line": "l02"
  },
  {
    "t0": 5.9,
    "t1": 7.26,
    "text": "And the fern still sulks.",
    "speaker": "narrator",
    "line": "l03"
  },
  {
    "t0": 8.5,
    "t1": 9.915,
    "text": "Then she reads the cap.",
    "speaker": "narrator",
    "line": "l04"
  },
  {
    "t0": 9.915,
    "t1": 11.326,
    "text": "One capful per litre.",
    "speaker": "narrator",
    "line": "l04"
  },
  {
    "t0": 11.8,
    "t1": 12.82,
    "text": "Every two weeks.",
    "speaker": "narrator",
    "line": "l05"
  },
  {
    "t0": 12.82,
    "t1": 13.62,
    "text": "No more guessing.",
    "speaker": "narrator",
    "line": "l05"
  },
  {
    "t0": 14.4,
    "t1": 15.578,
    "text": "Standoff over.",
    "speaker": "narrator",
    "line": "l06"
  },
  {
    "t0": 16.9,
    "t1": 17.438,
    "text": "Sprigly.",
    "speaker": "narrator",
    "line": "l07"
  },
  {
    "t0": 17.438,
    "t1": 19.173,
    "text": "One capful, no guessing.",
    "speaker": "narrator",
    "line": "l07"
  }
]
