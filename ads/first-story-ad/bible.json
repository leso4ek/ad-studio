      {
        "id": "l01",
        "text": "Every Sunday, Juno and her fern have a standoff.",
        "at": 0.3,
        "speaker": "narrator",
        "asr": "Every Sunday, Juneau and her fern have a standoff."
      },
      {
        "id": "l02",
        "text": "She waters, she guesses, she hopes.",
        "at": 3.4,
        "speaker": "narrator"
      },
      {
        "id": "l03",
        "text": "And the fern still sulks.",
        "at": 5.9,
        "speaker": "narrator"
      },
      {
        "id": "l04",
        "text": "Then she reads the cap. One capful per litre.",
        "at": 8.5,
        "speaker": "narrator",
        "asr": "Then she reads the cap, one cap full per liter."
      },
      {
        "id": "l05",
        "text": "Every two weeks. No more guessing.",
        "at": 11.8,
        "speaker": "narrator"
      },
      {
        "id": "l06",
        "text": "Standoff over.",
        "at": 14.4,
        "speaker": "narrator",
        "asr": "Stand off over."
      },
      {
        "id": "l07",
        "text": "Sprigly. One capful, no guessing.",
