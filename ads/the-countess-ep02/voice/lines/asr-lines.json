[
  {
    "id": "l01",
    "text": "Six years, and you still count the bars."
  },
  {
    "id": "l02",
    "text": "Twenty-two. Same as yesterday."
  },
  {
    "id": "l03",
    "text": "Give me your hand."
  },
  {
    "id": "l04",
    "text": "Twenty-four words. Learn them. Then wash them off."
  },
  {
    "id": "l05",
    "text": "What are they?"
  },
  {
    "id": "l06",
    "text": "Eleven million dollars. Nobody knows it exists."
  },
  {
    "id": "l07",
    "text": "Spend it on a life, Edie. Not on them."
  },
  {
    "id": "l08",
    "text": "Ivo? Ivo."
  },
  {
    "id": "l09",
    "text": "My old firm. For sale."
  },
  {
    "id": "l10",
    "text": "Buy it."
  }
]
